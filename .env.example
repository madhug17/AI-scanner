# AI App Security & Quality Scanner Environment Configuration

# Application
APP_NAME="AI App Security & Quality Scanner"
APP_ENV=development
APP_DEBUG=false
API_HOST=0.0.0.0
API_PORT=8000
SCAN_VERSION=1.0.0

# Database (PostgreSQL)
DATABASE_URL=postgresql://scanner_user:scanner_pass@localhost:5432/scanner_db
# Test Database URL (optional fallback)
# DATABASE_URL=sqlite:///./scanner.db

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_RATE_LIMIT_PER_MINUTE=60
REDIS_SCAN_CACHE_TTL=3600

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SCAN_REQUESTS_TOPIC=scan.requested
KAFKA_SCAN_DEADLETTER_TOPIC=scan.deadletter
KAFKA_CONSUMER_GROUP=scanner-workers

# Repository & Scanning Limits
MAX_REPO_CLONE_TIMEOUT_SEC=120
MAX_REPO_SIZE_MB=100
MAX_FILE_SIZE_BYTES=1048576

# External Analyzers
SEMGREP_BINARY=semgrep
GITLEAKS_BINARY=gitleaks
PIP_AUDIT_BINARY=pip-audit
OSV_API_URL=https://api.osv.dev/v1/query

